{
  "name": "workers",
  "private": true,
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "format": "oxfmt --write --config oxfmt.config.ts .",
    "format:check": "oxfmt --check --config oxfmt.config.ts .",
    "lint": "turbo run build && oxlint --config oxlint.config.ts .",
    "lint:ci": "oxlint --config oxlint.config.ts .",
    "lint:fix": "turbo run build && oxlint --config oxlint.config.ts --fix ."
  },
  "devDependencies": {
    "@bachman-dev/oxc-config": "0.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.6",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  }
}
