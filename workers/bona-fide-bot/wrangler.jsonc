{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bona-fide-bot",
  "compatibility_date": "2026-11-09",
  "main": "./src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "secrets": {
    // BASE_PATH: the interactions route. DISCORD_APP_ID, DISCORD_APP_SECRET, DISCORD_PUBLIC_KEY: the bot's application.
    // DISCORD_OWNER_ID: the Discord user who may press review buttons and run /screen.
    "required": ["BASE_PATH", "DISCORD_APP_ID", "DISCORD_APP_SECRET", "DISCORD_OWNER_ID", "DISCORD_PUBLIC_KEY"],
  },
  "queues": {
    "producers": [
      {
        "binding": "DISCORD_QUEUE",
        "queue": "discord-message-queue",
      },
      {
        "binding": "DEAD_LETTER_QUEUE",
        "queue": "dead-letters",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY",
        "class_name": "DiscordGateway",
      },
    ],
  },
  // Answers review buttons and edits the sender lists. Previews don't inherit top-level service bindings, and this one is
  // left out of `previews` on purpose, so a preview can never change the live Screener's rules.
  "services": [
    {
      "binding": "SCREENER",
      "service": "mail-screener",
      "entrypoint": "ScreenerService",
    },
  ],
  "exports": {
    "DiscordGateway": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "triggers": {
    // Starts and reconciles Gateway shards; each shard's alarm keeps it connected between runs.
    "crons": ["*/10 * * * *"],
  },
  "previews": {
    "queues": {
      "producers": [
        {
          "binding": "DISCORD_QUEUE",
          "queue": "preview-discord-message-queue",
        },
        {
          "binding": "DEAD_LETTER_QUEUE",
          "queue": "preview-dead-letters",
        },
      ],
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "GATEWAY",
          "class_name": "DiscordGateway",
        },
      ],
    },
  },
}
