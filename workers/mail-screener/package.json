    "types": "wrangler types"
  },
  "dependencies": {
    "@bachman-dev/workers-shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "vitest": "5.1.1",
    "wrangler": "4.163.0"
  }
}
