{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mail-screener",
  "compatibility_date": "2026-11-09",
  "main": "./src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "secrets": {
    // DESTINATION: the verified address mail is forwarded to. DISCORD_APP_ID: the bot that posts review cards.
    // DISCORD_CHANNEL_ID: the channel review cards are posted in.
    "required": ["DESTINATION", "DISCORD_APP_ID", "DISCORD_CHANNEL_ID"],
  },
  "queues": {
    "producers": [
      {
        "binding": "DISCORD_QUEUE",
        "queue": "discord-message-queue",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCREENER",
        "class_name": "Screener",
      },
    ],
  },
  "exports": {
    "Screener": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "previews": {
    "queues": {
      "producers": [
        {
          "binding": "DISCORD_QUEUE",
          "queue": "preview-discord-message-queue",
        },
      ],
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "SCREENER",
          "class_name": "Screener",
        },
      ],
    },
  },
}
