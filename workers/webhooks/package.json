{
  "name": "webhooks",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "wrangler d1 migrate",
    "deploy": "pnpm types && pnpm check && wrangler deploy",
    "types": "wrangler types",
    "types:openapi": "node ./scripts/types.ts"
  },
  "dependencies": {
    "@bachman-dev/workers-shared": "workspace:*",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "openapi-typescript": "7.13.0"
  }
}
