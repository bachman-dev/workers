{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webhooks",
  "compatibility_date": "2026-09-24",
  "main": "./src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": ["BASE_PATH", "DISCORD_MENTION_ID", "GITHUB_WEBHOOK_SECRET", "GITHUB_WEBHOOK_ID"],
  },
  "r2_buckets": [
    {
      "binding": "GITHUB_BUCKET",
      "bucket_name": "github-webhook-deliveries",
      "preview_bucket_name": "github-webhook-deliveries-preview",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "github-webhook-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "dead-letters",
      },
    ],
    "producers": [
      {
        "binding": "DISCORD_QUEUE",
        "queue": "discord-message-queue",
      },
      {
        "binding": "GITHUB_QUEUE",
        "queue": "github-webhook-queue",
      },
      {
        "binding": "DEAD_LETTER_QUEUE",
        "queue": "dead-letters",
      },
    ],
  },
  "previews": {
    "r2_buckets": [
      {
        "binding": "GITHUB_BUCKET",
        "bucket_name": "github-webhook-deliveries-preview",
      },
    ],
    "queues": {
      "consumers": [
        {
          "queue": "preview-github-webhook-queue",
          "max_batch_size": 10,
          "max_batch_timeout": 5,
          "dead_letter_queue": "preview-dead-letters",
        },
      ],
      "producers": [
        {
          "binding": "DISCORD_QUEUE",
          "queue": "preview-discord-message-queue",
        },
        {
          "binding": "GITHUB_QUEUE",
          "queue": "preview-github-webhook-queue",
        },
        {
          "binding": "DEAD_LETTER_QUEUE",
          "queue": "preview-dead-letters",
        },
      ],
    },
  },
}
