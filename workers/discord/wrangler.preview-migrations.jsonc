// Used only to apply D1 migrations to the Preview database, since `wrangler d1 migrations apply` reads top-level
// `d1_databases` and ignores `previews.d1_databases`. Keep this in sync with `previews.d1_databases` in wrangler.jsonc.
// See https://developers.cloudflare.com/workers/previews/resources/#d1-migrations
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-preview",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
}
