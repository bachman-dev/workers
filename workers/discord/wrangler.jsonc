{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "discord",
  "compatibility_date": "2026-09-28",
  "main": "./src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "discord-message-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "dead-letters",
      },
    ],
    "producers": [
      {
        "binding": "DEAD_LETTER_QUEUE",
        "queue": "dead-letters",
      },
    ],
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "discord-preview",
        "database_id": "3e83daf4-a098-46aa-bf6b-59f1e171cd2e",
        "migrations_dir": "drizzle",
        "migrations_pattern": "drizzle/*/migration.sql",
      },
    ],
    "queues": {
      "consumers": [
        {
          "queue": "preview-discord-message-queue",
          "max_batch_size": 10,
          "max_batch_timeout": 5,
          "dead_letter_queue": "preview-dead-letters",
        },
      ],
      "producers": [
        {
          "binding": "DEAD_LETTER_QUEUE",
          "queue": "preview-dead-letters",
        },
      ],
    },
  },
}
