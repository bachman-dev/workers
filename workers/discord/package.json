{
  "name": "discord",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit && tsc --noEmit -p tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrate",
    "deploy": "pnpm types && pnpm check && wrangler deploy",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@bachman-dev/workers-shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-ab785fc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.3",
    "@discordjs/rest": "2.6.3",
    "@types/node": "26.6.6",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vitest": "5.1.1"
  }
}
